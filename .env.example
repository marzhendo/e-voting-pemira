# ==============================================================================
# E-Voting Pemira HMIF - Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or expose production secrets in this file.
# ==============================================================================

# Application Environment
# Options: development | staging | production
APP_ENV=development
NODE_ENV=development

# Canonical Application URLs
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Configuration
# Secret key used for signing session cookies (minimum 32 characters)
SESSION_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars

# Development Dummy Authentication
# MUST be set to false in production. Allows local mock testing without real Entra ID.
ENABLE_DUMMY_AUTH=true

# Microsoft Entra ID (OIDC Authentication)
# Application (client) ID registered in Microsoft Entra portal
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client Secret (Server-only, required for confidential client flow if applicable)
MICROSOFT_CLIENT_SECRET=placeholder-client-secret

# Allowed Tenant ID: Telkom University Tenant ID (restricts sign-in to verified campus accounts)
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Redirect URI configured in Microsoft Entra App Registration
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback/entra

# Supabase Platform
# Public URL of the Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (client-safe, strictly bound by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Privileged service role key (SERVER-ONLY, NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# PostgreSQL Direct Connection URL (Used for migrations/scripts)
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# End-to-End Testing (Playwright)
PLAYWRIGHT_BASE_URL=http://localhost:3000
# Optional: Path to Brave browser executable if running local Brave tests
# BRAVE_PATH="C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
