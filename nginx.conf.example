# ==============================================================================
# Nginx Configuration for Pemira HMIF E-Voting Platform
# Location on Debian 12: /etc/nginx/sites-available/pemira-hmif.conf
# Enable with: sudo ln -s /etc/nginx/sites-available/pemira-hmif.conf /etc/nginx/sites-enabled/
# ==============================================================================

# 1. Rate Limiting Zones (Mitigasi DDoS & Spam)
# Zone untuk API umum: 30 request/detik per IP (burst 50 aman untuk Wi-Fi kampus)
limit_req_zone $binary_remote_addr zone=general_api:10m rate=30r/s;
# Zone khusus OTP endpoint: 5 request/detik per IP (burst 10)
limit_req_zone $binary_remote_addr zone=otp_limit:10m rate=5r/s;

# 2. Upstream Next.js Standalone Cluster (PM2 2-Instances)
upstream nextjs_backend {
    server 127.0.0.1:3000 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

# 3. HTTP Server (Redirect ke HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name pemirahmif.org www.pemirahmif.org; # Ganti dengan domain Anda

    # Let's Encrypt ACME Challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 4. HTTPS Server (Production Secure Gateway)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pemirahmif.org www.pemirahmif.org; # Ganti dengan domain Anda

    # SSL Certificates (Akan dikonfigurasi otomatis oleh Certbot)
    # ssl_certificate /etc/letsencrypt/live/pemirahmif.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/pemirahmif.org/privkey.pem;

    # SSL Security Hardening
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Security Headers
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip Compression (Mempercepat load di port 20 Mbps)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Maximum Upload Size (untuk upload foto kandidat / CV BAST)
    client_max_body_size 10M;

    # Static Assets Cache (Bypass Node.js: langsung dilayani Nginx dengan zero-copy sendfile)
    location /_next/static/ {
        alias /var/www/e-voting/.next/static/;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /assets/ {
        alias /var/www/e-voting/public/assets/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    location /candidates/ {
        alias /var/www/e-voting/public/candidates/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    # Proteksi Rate Limit Khusus Endpoint OTP
    location /api/auth/otp/ {
        limit_req zone=otp_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse Proxy Utama ke Next.js Node.js Cluster
    location / {
        limit_req zone=general_api burst=50 nodelay;

        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
