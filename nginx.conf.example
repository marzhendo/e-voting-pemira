# ==============================================================================
# Nginx Configuration for Pemira HMIF E-Voting Platform
# Location on Ubuntu 22.04 LTS: /etc/nginx/sites-available/pemira-hmif.conf
# Enable with: sudo ln -sf /etc/nginx/sites-available/pemira-hmif.conf /etc/nginx/sites-enabled/
# ==============================================================================

# 1. Rate Limiting Zones (Mitigasi DDoS, Brute-Force & Spam Request)
# Zone untuk API umum & web browsing: 30 request/detik per IP (burst 50 aman untuk Wi-Fi kampus)
limit_req_zone $binary_remote_addr zone=general_api:10m rate=30r/s;
# Zone khusus OTP endpoint: 5 request/detik per IP (burst 10)
limit_req_zone $binary_remote_addr zone=otp_limit:10m rate=5r/s;

# 2. Upstream Next.js Standalone Cluster (PM2 4-Instances / 4 Cores)
upstream nextjs_backend {
    server 127.0.0.1:3000 max_fails=3 fail_timeout=10s;
    keepalive 64;
}

# 3. HTTP Server (Port 80)
# Secara default melayani reverse proxy langsung ke Next.js (port 3000).
# Jika SSL sudah aktif via Certbot, aktifkan redirect ke HTTPS di bawah.
server {
    listen 80;
    listen [::]:80;
    server_name 103.155.224.62 _ pemirahmif.com www.pemirahmif.com; # IP VPS dan domain resmi

    # Security Headers Standar (selaras dengan next.config.mjs)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip Compression (Menghemat bandwidth dan mempercepat loading)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Maximum Upload Size (untuk upload foto kandidat / berkas BAST)
    client_max_body_size 10M;

    # Let's Encrypt ACME Challenge (Validasi SSL Otomatis)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Static Assets Cache (Bypass Node.js: langsung dilayani Nginx dengan zero-copy sendfile)
    location /_next/static/ {
        alias /var/www/e-voting/.next/static/;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /assets/ {
        alias /var/www/e-voting/public/assets/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    location /candidates/ {
        alias /var/www/e-voting/public/candidates/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    location /uploads/ {
        alias /var/www/e-voting/public/uploads/;
        expires 7d;
        access_log off;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control "public, max-age=604800";
    }

    # Proteksi Rate Limit Khusus Endpoint OTP
    location /api/auth/otp/ {
        limit_req zone=otp_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # PENTING: Gunakan $remote_addr (bukan $proxy_add_x_forwarded_for) agar klien tidak bisa memalsukan X-Forwarded-For untuk mem-bypass rate limiter
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Reverse Proxy Utama ke Next.js Node.js Cluster
    location / {
        limit_req zone=general_api burst=50 nodelay;

        proxy_pass http://nextjs_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout settings
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # [OPSIONAL] Uncomment baris berikut jika SSL sudah aktif dan ingin memaksakan redirect HTTPS:
    # location / {
    #     return 301 https://$host$request_uri;
    # }
}

